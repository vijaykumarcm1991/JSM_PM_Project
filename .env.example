# 64-hex-char encryption key for AES-256-GCM.
# If unset, the app automatically generates and persists a key to .data/secret.key
APP_ENCRYPTION_KEY=

# Maximum concurrent Jira issue creation / attachment upload tasks (default: 2)
JIRA_CONCURRENCY=2

# Minimum interval between outgoing Jira API requests in milliseconds (default: 300)
JIRA_MIN_INTERVAL_MS=300

# Maximum size per attachment file in megabytes (default: 20)
MAX_ATTACHMENT_MB=20

# Maximum number of attachments allowed per row (default: 10)
MAX_ATTACHMENTS_PER_ROW=10

# Set to 1 to allow custom Jira hostnames outside *.atlassian.net (default: 0)
ALLOW_CUSTOM_JIRA_HOST=0
